# agent/.env.example
# Copy to .env and fill in your key: cp .env.example .env
# Read by `make dev-agent` to run the agent locally, outside Docker.
# (For the Docker Compose stack, use the root .env.example instead.)

# One of: anthropic, openai, ollama, openrouter (default: openrouter)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# No key needed — set LLM_PROVIDER=ollama above and run Ollama locally.
OLLAMA_HOST=
OLLAMA_MODEL=

# Listen address.
AGUI_ADDR=:8080

# Comma-separated origins the agent accepts CORS requests from, or "*".
# Only needed if a browser-based playground (not Docker Compose) will call
# this agent directly, cross-origin.
AGUI_ALLOWED_ORIGINS=
