# .env.example
# Copy to .env and fill in a key: cp .env.example .env
# Read by `docker compose up` for the two-service playground stack
# (the agent + the langport UI). For running the agent alone, outside
# Docker, see agent/.env.example instead.

# Port the agent listens on and that langport talks to it over.
AGUI_PORT=8080

# One of: anthropic, openai, ollama, openrouter (default: openrouter)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# No key needed — set LLM_PROVIDER=ollama above and run Ollama locally.
OLLAMA_HOST=
OLLAMA_MODEL=

# Comma-separated origins the agent accepts CORS requests from, or "*".
AGUI_ALLOWED_ORIGINS=*
